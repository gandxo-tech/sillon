{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".cache/tests",
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/moteur/**/*.ts", "src/data/**/*.ts", "src/analyse/**/*.ts", "src/rapport/**/*.ts"],
  "exclude": ["src/**/*.tsx"]
}
